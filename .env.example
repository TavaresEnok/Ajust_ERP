# ══════════════════════════════════════════════════════════════════
#  Ajust ERP — Variáveis de Ambiente
#  Copie este arquivo para .env e ajuste os valores.
#  Variáveis marcadas com [PROD] DEVEM ser alteradas antes do deploy.
# ══════════════════════════════════════════════════════════════════

# ─── Portas externas (Slot 4) ───────────────────────────────────
WEB_PORT=8070
API_PORT=8071
WORKER_PORT=8076
POSTGRES_PORT=8072
REDIS_PORT=8073
PGADMIN_PORT=8077

# ─── Portas internas dos containers ────────────────────────────
INTERNAL_WEB_PORT=3000
INTERNAL_API_PORT=3001
INTERNAL_WORKER_PORT=3002

# ─── Banco de dados ─────────────────────────────────────────────
# ⚠️  [DEV ONLY] Use valores seguros em produção!
# [PROD] Gere senha aleatória: openssl rand -hex 16
POSTGRES_DB=ajust_erp
POSTGRES_USER=ajust
POSTGRES_PASSWORD=dev-temporary-password-change-in-prod
DATABASE_URL=postgresql://ajust:dev-temporary-password-change-in-prod@postgres:5432/ajust_erp?schema=public&connection_limit=20

# ─── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=volatile-lru

# ─── Conectividade interna (rede Docker) ────────────────────────
API_INTERNAL_URL=http://api:3001
WORKER_INTERNAL_URL=http://worker:3002

# ─── Credenciais demo (componentes server-side do web) ─────────
WEB_DEMO_EMAIL=admin@ajust.local
WEB_DEMO_PASSWORD=Admin@123456
# WEB_TENANT_ID=

# ─── JWT & Criptografia ─────────────────────────────────────────
# ⚠️  [DEV ONLY] Valores abaixo são para desenvolvimento LOCAL apenas
# [PROD] GERE SECRETS FORTES:
#   openssl rand -hex 32 → JWT_ACCESS_SECRET
#   openssl rand -hex 32 → JWT_REFRESH_SECRET  
#   openssl rand -hex 32 → SECRETS_ENCRYPTION_KEY
# Armazene estes valores FORA do Git (use Vault/Secrets Manager)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
JWT_ACCESS_SECRET=dev-only-change-in-production-NEVER-COMMIT-REAL-SECRETS
JWT_REFRESH_SECRET=dev-only-change-in-production-NEVER-COMMIT-REAL-SECRETS
JWT_RESET_SECRET=dev-only-change-in-production-NEVER-COMMIT-REAL-SECRETS
# [PROD] Segredo para tokens 2FA (TOTP). Gere com: openssl rand -hex 32
JWT_2FA_SECRET=dev-only-change-in-production-NEVER-COMMIT-REAL-SECRETS

# ⚠️  [PROD] Chave AES-256-GCM para criptografia de credentials
SECRETS_ENCRYPTION_KEY=dev-only-change-in-production-32-char-minimum

# ─── SMTP / Email ────────────────────────────────────────────────
# Deixe em branco para simular envios no console (modo mock)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remetente exibido nos emails enviados
SMTP_FROM="Ajust ERP <noreply@ajusterp.com.br>"

# ─── URLs Públicas ───────────────────────────────────────────────
# [PROD] URL pública do frontend — usada em links de email (reset de senha, CSAT, etc.)
WEB_BASE_URL=http://localhost:8070
# Alias de WEB_BASE_URL utilizado em alguns módulos
FRONTEND_URL=http://localhost:8070

# ─── Uploads & Worker ───────────────────────────────────────────
UPLOAD_ROOT=/workspace/uploads
IXC_RECONCILE_INTERVAL_MS=300000
EXPORT_RETENTION_DAYS=30
EXPORT_RETENTION_INTERVAL_MS=3600000
IXC_WEBHOOK_REQUIRE_SIGNATURE=true

# [PROD] Mude para false — IXC_MOCK_RECONCILE=false desabilita sync real com SGP/IXC
IXC_MOCK_RECONCILE=false
MONITORING_WEBHOOK_TOKEN=dev-monitoring-webhook-token-change-in-production
CHAT_WEBHOOK_TOKEN=dev-chat-webhook-token-change-in-production
WORKER_API_TOKEN=dev-worker-api-token-change-in-production

# ─── Workflows / Automação ─────────────────────────────────────
# Liga a execução real de ações de workflow (action_notify_slack, action_assign,
# action_escalate, action_webhook, action_csat, task_service, action_close_order).
# Padrão: true. Para desligar temporariamente (ex: incidente em produção),
# defina WORKFLOW_EXECUTION_ENABLED=false. A UI continua exibindo as regras
# configuradas, mas nenhuma ação será disparada.
WORKFLOW_EXECUTION_ENABLED=true
# Máximo de execuções por hora por regra (rate limit; 0 = ilimitado)
WORKFLOW_MAX_EXECUTIONS_PER_HOUR=120

# ─── Ambiente ────────────────────────────────────────────────────
# [PROD] Defina NODE_ENV=production para ativar validações de segurança
NODE_ENV=development
